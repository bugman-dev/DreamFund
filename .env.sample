# Required. Google Cloud "Web application" OAuth client ID.
# Turns on Continue with Google. Restart Expo after changing this file.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional. Used on iOS and Android when those builds have their own client IDs.
# Leave blank to use the web client ID above.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Google OAuth token endpoint — refresh access tokens with the stored refresh token.
EXPO_PUBLIC_GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token

# Drive API v3 base — list, metadata, download under appDataFolder.
EXPO_PUBLIC_GOOGLE_DRIVE_API_BASE=https://www.googleapis.com/drive/v3

# Drive upload endpoint — create/update file content in appDataFolder.
EXPO_PUBLIC_GOOGLE_DRIVE_UPLOAD_BASE=https://www.googleapis.com/upload/drive/v3

# Scope requested at Google sign-in for the hidden app folder.
EXPO_PUBLIC_GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive.appdata
